{
  "name": "ez-scanner",
  "version": "1.6.0",
  "description": "EZ Scanner — clean-IP discovery engine for Cloudflare/SNI tunnels with a powerful local GUI and a scriptable CLI",
  "type": "module",
  "license": "MIT",
  "author": "ezzaeskardi-afk",
  "homepage": "https://github.com/ezzaeskardi-afk/EZ_scanner",
  "repository": {
    "type": "git",
    "url": "https://github.com/ezzaeskardi-afk/EZ_scanner.git"
  },
  "keywords": [
    "cloudflare",
    "clean-ip",
    "scanner",
    "v2ray",
    "xray",
    "vless",
    "trojan",
    "dpi",
    "censorship"
  ],
  "bin": {
    "ezscan": "./src/cli/main.ts",
    "ez-scanner": "./src/cli/main.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/cli/main.ts gui",
    "gui": "node src/cli/main.ts gui",
    "scan": "node src/cli/main.ts scan",
    "doctor": "node src/cli/main.ts doctor",
    "selftest": "node src/cli/main.ts selftest",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "check:deadcode": "node --test test/deadcode.test.ts",
    "check:openui-css": "node --test test/openui-css.test.ts",
    "prune:openui": "node scripts/prune-openui-css.ts",
    "notes": "node scripts/release-notes.ts",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
